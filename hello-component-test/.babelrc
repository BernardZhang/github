{
    
    "presets": [
        ["@babel/env", { "targets": { "node": 6 } }],
        "@babel/preset-react"
    ],
    "plugins": [
        "lodash",
        [
            "import",
            {
                "libraryName": "antd",
//                "libraryDirectory": "es",
                "style": true
            }
        ]
    ]
}
